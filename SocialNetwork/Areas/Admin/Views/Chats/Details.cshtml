@model SocialNetwork.Areas.Admin.Models.ChatDetailsViewModel

@{
    ViewData["Title"] = "Chat Details";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header">
                    <h2>Chat Details Managing</h2>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header">
                                    <h5>User 1 Information</h5>
                                </div>
                                <div class="card-body">
                                    <dl class="row">
                                        <dt class="col-sm-3">ID</dt>
                                        <dd class="col-sm-9">@Model.User1Id</dd>

                                        <dt class="col-sm-3">Email</dt>
                                        <dd class="col-sm-9">@Model.User1Email</dd>

                                        <dt class="col-sm-3">Name</dt>
                                        <dd class="col-sm-9">@Model.User1Name</dd>
                                    </dl>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header">
                                    <h5>User 2 Information</h5>
                                </div>
                                <div class="card-body">
                                    <dl class="row">
                                        <dt class="col-sm-3">ID</dt>
                                        <dd class="col-sm-9">@Model.User2Id</dd>

                                        <dt class="col-sm-3">Email</dt>
                                        <dd class="col-sm-9">@Model.User2Email</dd>

                                        <dt class="col-sm-3">Name</dt>
                                        <dd class="col-sm-9">@Model.User2Name</dd>
                                    </dl>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card mt-4">
                        <div class="card-header">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-3">
                                    <h5 class="mb-0">Messages</h5>
                                    <div class="input-group" style="width: 300px;">
                                        <span class="input-group-text bg-primary">
                                            <i class="fas fa-search text-white"></i>
                                        </span>
                                        <input type="text" 
                                               id="searchInput" 
                                               class="form-control" 
                                               placeholder="Search messages..." />
                                    </div>
                                </div>
                                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addMessageModal">
                                    Add Message
                                </button>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Sender</th>
                                            <th>Content</th>
                                            <th>Is Read</th>
                                            <th>Created</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var message in Model.Messages)
                                        {
                                            <tr class="message-row">
                                                <td class="message-id">@message.Id</td>
                                                <td class="message-sender">
                                                    <div>@message.SenderName</div>
                                                    <small class="text-muted">@message.SenderEmail</small>
                                                </td>
                                                <td class="message-content">@message.Content</td>
                                                <td class="message-read">
                                                    @if (message.IsRead)
                                                    {
                                                        <span class="badge bg-success">Read</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning">Unread</span>
                                                    }
                                                </td>
                                                <td>@message.CreatedDate.ToString()</td>
                                              
                                                <td>
                                                    <div class="btn-group">
                                                        <button type="button" class="btn btn-primary btn-sm" 
                                                                data-bs-toggle="modal" 
                                                                data-bs-target="#editMessageModal" 
                                                                data-message-id="@message.Id"
                                                                data-message-content="@message.Content"
                                                                data-message-isread="@message.IsRead">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                        <form asp-action="DeleteMessage" asp-route-id="@message.Id" method="post" class="d-inline">
                                                            <input type="hidden" name="chatId" value="@Model.Id" />
                                                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this message?');">
                                                                <i class="fas fa-trash"></i>
                                                            </button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit Chat</a>
                        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addMessageModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Message</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddMessage" method="post">
                <div class="modal-body">
                    <input type="hidden" name="chatId" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label">Sender</label>
                        <select name="senderId" class="form-control" required>
                            <option value="@Model.User1Id">@Model.User1Name (@Model.User1Email)</option>
                            <option value="@Model.User2Id">@Model.User2Name (@Model.User2Email)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Content</label>
                        <textarea name="content" class="form-control" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Add Message</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editMessageModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Message</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="UpdateMessage" method="post">
                <div class="modal-body">
                    <input type="hidden" name="messageId" id="editMessageId" />
                    <input type="hidden" name="chatId" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label">Content</label>
                        <textarea name="content" id="editMessageContent" class="form-control" required></textarea>
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="isRead" id="editMessageIsRead" value="true">
                            <input type="hidden" name="isRead" value="false" />
                            <label class="form-check-label" for="editMessageIsRead">Is Read</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('editMessageModal').addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var messageId = button.getAttribute('data-message-id');
            var messageContent = button.getAttribute('data-message-content');
            var messageIsRead = button.getAttribute('data-message-isread').toLowerCase() === 'true';

            document.getElementById('editMessageId').value = messageId;
            document.getElementById('editMessageContent').value = messageContent;
            document.getElementById('editMessageIsRead').checked = messageIsRead;
        });

        $(document).ready(function() {
            $("#searchInput").on("keyup", function() {
                var value = $(this).val().toLowerCase();
                $(".message-row").filter(function() {
                    var id = $(this).find(".message-id").text().toLowerCase();
                    var sender = $(this).find(".message-sender").text().toLowerCase();
                    var content = $(this).find(".message-content").text().toLowerCase();
                    var isRead = $(this).find(".message-read").text().toLowerCase();
                    $(this).toggle(
                        id.indexOf(value) > -1 || 
                        sender.indexOf(value) > -1 || 
                        content.indexOf(value) > -1 || 
                        isRead.indexOf(value) > -1
                    );
                });
            });
        });
    </script>
} 