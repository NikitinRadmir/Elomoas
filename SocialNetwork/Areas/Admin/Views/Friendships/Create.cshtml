@model SocialNetwork.Areas.Admin.Models.CreateFriendshipViewModel
@using Elomoas.Domain.Entities.Enums

@{
    ViewData["Title"] = "Create Friendship";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header">
                    <h5>Create New Friendship</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="UserId" class="form-label">User</label>
                            <select asp-for="UserId" asp-items="ViewBag.Users" class="form-select">
                                <option value="">Select User</option>
                            </select>
                            <span asp-validation-for="UserId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FriendId" class="form-label">Friend</label>
                            <select asp-for="FriendId" asp-items="ViewBag.Users" class="form-select">
                                <option value="">Select Friend</option>
                            </select>
                            <span asp-validation-for="FriendId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Status" class="form-label">Status</label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<FriendshipStatus>()" class="form-select">
                                <option value="">Select Status</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i data-feather="save" class="me-2"></i>Create
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i data-feather="x" class="me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            feather.replace();

            // Предотвращаем выбор одного и того же пользователя
            $('#UserId, #FriendId').change(function() {
                var userId = $('#UserId').val();
                var friendId = $('#FriendId').val();

                if (userId && friendId && userId === friendId) {
                    alert('User and Friend cannot be the same person');
                    $(this).val('');
                }
            });
        });
    </script>
} 